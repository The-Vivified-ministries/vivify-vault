# Postgres — from Supabase: Project Settings → Database → Connection
# string → "Transaction pooler" (recommended over the direct connection
# for reliability with a backend that can cold-start, like Render free tier)
DATABASE_URL=postgresql://postgres.tonbixunurtzqpjfeywy:[wehavebeenvivified]@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Pinecone (https://app.pinecone.io — free tier)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vivify-vault-sermons
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Groq (https://console.groq.com — free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true

# Admin — pick your own long random string, protects /admin/* routes
ADMIN_SECRET=change-me-to-something-random
SUPABASE_OWNER_EMAIL=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=smtp-user@example.com
SMTP_PASSWORD=super-secret

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Only needed for scripts/fill_descriptions_from_spotify.py
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=NG

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.vercel.app

CATEGORY_SUBCATEGORIES={"Theological":["Soteriology","Christology"],"Events":["Conferences"]}