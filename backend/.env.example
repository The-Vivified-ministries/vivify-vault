# Pinecone (https://app.pinecone.io — free tier)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=vivify-vault-sermons
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Groq (https://console.groq.com — free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_ENABLED=true

# Admin — pick your own long random string, used to protect /admin/* routes
ADMIN_SECRET=change-me-to-something-random

# Data source option A: publish a Google Sheet as CSV (File > Share >
# Publish to web > CSV) and paste that URL here. Leave blank if you'd
# rather upload an .xlsx file directly to /admin/sync each time instead.
SHEET_CSV_URL=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.vercel.app
